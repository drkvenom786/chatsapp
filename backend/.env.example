# Firebase Public Config Variables
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_VAPID_KEY=your_vapid_key

# Frontend URL (Netlify / custom domain) for push notifications & click actions
FRONTEND_URL=https://your-app.netlify.app

# CORS: Comma-separated allowed frontend domains, or leave blank to allow all (*)
ALLOWED_ORIGINS=*

# Backend Access Key (Set via 'wrangler secret put BACKEND_ACCESS_KEY' in production)
BACKEND_ACCESS_KEY=

# Firebase Push Notification Secrets (Set via 'wrangler secret put <NAME>' in production)
# Option A: Legacy FCM Server Key
FCM_SERVER_KEY=
# Option B: HTTP v1 Firebase Service Account JSON (single line JSON string)
FIREBASE_SERVICE_ACCOUNT=
